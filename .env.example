# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional. Live $9.99/mo is used when STRIPE_SECRET_KEY is sk_live. Set this to override.
# STRIPE_PRICE_ID=price_1UABs108z3zLzTvzj60seVsl

# Google Place Details (listing puller). Never commit the real key.
GOOGLE_PLACES_API_KEY=

# Optional durable shop JSON + photo uploads on Vercel
BLOB_READ_WRITE_TOKEN=

# Optional. Vercel cron for the 4-month host takedown (/api/host-expire).
# CRON_SECRET=

# Shop owner logins (signed cookies). Set a long random string in Vercel env.
AUTH_SECRET=

# IndexNow (Bing, Yandex, others — Google ignores it). Public key served at /{key}.txt
# on www and shop hosts. Default matches the committed key file. Rotate in Vercel if needed.
# INDEXNOW_KEY=c4e91a2f8b3647d0a1e95c82f0b3d6e7

# Sign in with Google. Google Cloud → APIs → Credentials → OAuth 2.0 Web client.
# Authorized JavaScript origins: https://www.yoursite.site
# Authorized redirect URIs can stay empty (we use the Google button / One Tap, not a redirect).
GOOGLE_AUTH_CLIENT_ID=

# Confirm-email, forgot-password, and after-pay mail (welcome, failed card, cancel, last chance).
# Required for those emails. Sign in with Google does not need this for login.
# Dashboard: turn on Stripe customer emails (receipts + failed payments).
# Dashboard: Customer Portal — update payment method AND cancel. No plan changes ($9.99 only).
# Webhook events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed, charge.refunded.
# RESEND_API_KEY=
# MAIL_FROM=Your Site <hello@yoursite.site>

# Local outreach board (npm run outreach → http://localhost:8787)
# SMS: Google Voice only. Main: pace47474@gmail.com — (254) 261-6091.
# Backup unused: pace4747@gmail.com — (254) 294-9405. Do not send or poll unless VOICE_BACKUP=1.
# Send from the Voice app (then log it) or Send via Voice email. Inbox poll reads pace47474.
# Workspace mail desk: Connect Mail as shawn@yoursite.site (aliases: support, hello, legal, billing).
# WORKSPACE_MAIL=shawn@yoursite.site
# VOICE_PACE4747=2542949405
# VOICE_PACE47474=2542616091
# VOICE_BACKUP=1
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:8787/api/gmail-callback
# OUTREACH_PORT=8787

