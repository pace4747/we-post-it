# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: durable site-document + photo storage on Vercel.
# Without this, the editor still works locally (data/sites or /tmp) but
# Vercel serverless disk is ephemeral — set this for production.
# BLOB_READ_WRITE_TOKEN=

# Optional override for the local/dev site JSON folder.
# SITE_STORE_DIR=

# Optional extra demo token (rr-electric is also seeded in sites/rr-electric/auth.json).
# DEMO_EDIT_TOKEN=
# DEMO_EDIT_SLUG=rr-electric
