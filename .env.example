# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Visitor Tracking (Optional)
# Webhook URL to receive visitor data (optional, fail open if not set)
# Both VISITOR_WEBHOOK and VISIT_WEBHOOK are supported (same value)
VISITOR_WEBHOOK=
VISIT_WEBHOOK=

# Admin key to protect GET /api/visit endpoint (required to view visitor logs)
# Only x-admin-key header is accepted, not query string
VISITOR_ADMIN_KEY=
