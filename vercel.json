{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/start",
      "destination": "/api/start"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/order",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/help",
      "destination": "/api/help"
    },
    {
      "source": "/vs/wix",
      "destination": "/vs/wix.html"
    },
    {
      "source": "/vs/squarespace",
      "destination": "/vs/squarespace.html"
    },
    {
      "source": "/vs/durable",
      "destination": "/vs/durable.html"
    },
    {
      "source": "/vs/hootsuite",
      "destination": "/vs/hootsuite.html"
    },
    {
      "source": "/vs/thryv",
      "destination": "/vs/thryv.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "trailingSlash": false
}
