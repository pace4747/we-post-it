      "destination": "/terms-of-service.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/online-presence",
      "destination": "/online-presence.html"
    },
    {
      "source": "/vs/wix",
      "destination": "/vs/wix.html"
    },
    {
      "source": "/vs/squarespace",
      "destination": "/vs/squarespace.html"
    },
    {
      "source": "/vs/durable",
      "destination": "/vs/durable.html"
    },
    {
      "source": "/vs/hootsuite",
      "destination": "/vs/hootsuite.html"
    },
    {
      "source": "/vs/thryv",
      "destination": "/vs/thryv.html"
    }
  ],
  "headers": [
    {
      "source": "/keep/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/keep",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/edit/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/edit.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "trailingSlash": false
}
