{
  "$comment": "Cache bust: 2026-08-30-23:59",
  "cleanUrls": true,
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/geo",
      "destination": "/api/geo"
    },
    {
      "source": "/api/visit",
      "destination": "/api/visit"
    },
    {
      "source": "/api/start",
      "destination": "/api/start"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/order",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/help",
      "destination": "/api/help"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/feedback"
    },
    {
      "source": "/s/:slug/call",
      "destination": "/api/shop-page?slug=:slug&look=call"
    },
    {
      "source": "/s/:slug/photos",
      "destination": "/api/shop-page?slug=:slug&look=photos"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/shop-page?slug=:slug"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/looks",
      "destination": "/looks.html"
    },
    {
      "source": "/notice",
      "destination": "/notice.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/vs/wix",
      "destination": "/vs/wix.html"
    },
    {
      "source": "/vs/squarespace",
      "destination": "/vs/squarespace.html"
    },
    {
      "source": "/vs/durable",
      "destination": "/vs/durable.html"
    },
    {
      "source": "/vs/hootsuite",
      "destination": "/vs/hootsuite.html"
    },
    {
      "source": "/vs/thryv",
      "destination": "/vs/thryv.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "trailingSlash": false
}
